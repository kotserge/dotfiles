#-------------------------- Basics -------------------------------#

# sway doesn't push its session env into systemd/D-Bus activation environment
# on its own; without this, D-Bus-activated services (e.g. xdg-desktop-portal)
# start with no DISPLAY/WAYLAND_DISPLAY and hang or fail.
exec dbus-update-activation-environment --systemd --all

output * scale 1
output eDP-1 disable

seat seat0 xcursor_theme default 12

#-------------------------- Style -------------------------------#

gaps inner 5
gaps outer 5

default_border pixel 2
default_floating_border pixel 2

# no direct sway equivalent to Hyprland's rounding/shadow/animations - omitted

client.focused          #ebdbb3aa #ebdbb3aa #000000 #ebdbb3aa #ebdbb3aa
client.focused_inactive #151515aa #151515aa #ffffff #151515aa #151515aa
client.unfocused        #151515aa #151515aa #ffffff #151515aa #151515aa

#-------------------------- Programs -------------------------------#

set $term alacritty
set $menu rofi -show drun

exec $HOME/.config/waybar/launch-sway.sh
exec swaybg -i $HOME/media/wallpaper/wall.jpg -m fill
exec dunst

# -------------------------- Keybindings -------------------------------#

input "type:keyboard" {
    xkb_layout us
}

input "type:touchpad" {
    natural_scroll disabled
}

# -------------------------- Keybindings -------------------------------#

set $mod Mod4

# -------------------------- Keybindings: Touchpad -------------------------------#

bindgesture swipe:3:left workspace next
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:up fullscreen toggle
bindgesture swipe:3:down kill

# -------------------------- Keybindings: Workspace -------------------------------#

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# -------------------------- Keybindings: Window -------------------------------#

# Move focus with mod + hjkl (vim-style, from i3/Hyprland)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows with mod + Shift + hjkl
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split direction: period = horizontal, comma = vertical
bindsym $mod+period splith
bindsym $mod+comma splitv

# Toggle layout split
bindsym $mod+e layout toggle split

# Fullscreen toggle
bindsym $mod+m fullscreen toggle

# Kill active window
bindsym $mod+Shift+q kill

# Toggle floating
bindsym $mod+f floating toggle

# Toggle Group (tabbed layout is the closest sway equivalent)
bindsym $mod+g layout toggle tabbed splith
# no direct sway equivalent to Hyprland's changegroupactive - omitted

# Resize mode (from i3/Hyprland resize submap)
mode "resize" {
    bindsym h resize shrink width 40px
    bindsym j resize grow height 40px
    bindsym k resize shrink height 40px
    bindsym l resize grow width 40px
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Scroll through existing workspaces with mod + scroll
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

# Move/resize windows with mod + LMB/RMB and dragging (built into floating_modifier)
floating_modifier $mod normal

# -------------------------- Keybindings: Applications -------------------------------#

# Terminal
bindsym $mod+Return exec $term

# Launcher
bindsym $mod+d exec $menu

# Screenshot (grim)
bindsym Print exec sh -c 'grim -g "$(slurp -d)" - | wl-copy'

# Lockscreen
bindsym $mod+Shift+s exec sh $HOME/.local/bin/lock

# Dunst notification history (from i3/Hyprland: mod+space)
bindsym $mod+space exec dunstctl history-pop

# Session management
bindsym $mod+Shift+e exit
bindsym $mod+Shift+r reload
bindsym $mod+Shift+c reload

# Laptop multimedia keys for volume and LCD brightness
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

# Requires playerctl
bindsym --locked --no-repeat XF86AudioNext exec playerctl next
bindsym --locked --no-repeat XF86AudioPause exec playerctl play-pause
bindsym --locked --no-repeat XF86AudioPlay exec playerctl play-pause
bindsym --locked --no-repeat XF86AudioPrev exec playerctl previous
